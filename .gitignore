.DS_Store

# Editor
.vscode/
.idea/

# Local tooling
*.log

# Local AI tool settings
.claude/settings.local.json
.claude/launch.json
# Session-open lock (#85) — ephemeral concurrency marker, session-start/session-end manage it
.claude/.session.lock
# Vendored agent skills (local tooling — reinstall via `npx skills add`; see docs/tech-architecture/integrations-and-access.md)
.claude/skills/
skills-lock.json

# Brand assets (keep locally, don't commit large binaries)
docs/Accelerator-X-brand-pack.pdf

# Image source staging area — processed variants only (-800, -400, -1200) are committed
assets/images/src/

# Dependencies
node_modules/

# Netlify CLI local state / config (never commit — may hold tokens)
.netlify/

# Netlify Edge Functions local tooling (Deno) — generated by `netlify dev`/`netlify build`
deno.lock
