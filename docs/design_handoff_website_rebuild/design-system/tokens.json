{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Accelerator X Design System tokens — v2.0 · 16 May 2026. Canonical source for colour, type, spacing, radii, shadows, motion. Generates tokens.css and any downstream platform exports (Tailwind preset, Figma, etc).",

  "color": {
    "brand": {
      "navy":       { "$value": "#1B2A4A", "$type": "color", "$description": "Primary dark — backgrounds, headlines" },
      "navyDeep":   { "$value": "#131D30", "$type": "color", "$description": "Section dividers, footer bars" },
      "pink":       { "$value": "#E93F8E", "$type": "color", "$description": "Signature accent — the X, primary CTAs" },
      "cyan":       { "$value": "#088ABF", "$type": "color", "$description": "Web 'go' colour, links, data" },
      "amber":      { "$value": "#FEA700", "$type": "color", "$description": "Outputs, highlights — decorative on light, text on dark only" },
      "purple":     { "$value": "#882DE7", "$type": "color", "$description": "Quaternary accent" },
      "green":      { "$value": "#1FBD53", "$type": "color", "$description": "Success" },
      "blue":       { "$value": "#3477F5", "$type": "color", "$description": "Functional blue" }
    },

    "surface": {
      "white":      { "$value": "#FFFFFF", "$type": "color" },
      "offWhite":   { "$value": "#F8FAFC", "$type": "color", "$description": "Secondary cool light" },
      "surface2":   { "$value": "#F1F5F9", "$type": "color", "$description": "Tertiary cool" },
      "paleBlue":   { "$value": "#F0F9FF", "$type": "color", "$description": "Tinted callout" },
      "paper":      { "$value": "#FAF8F3", "$type": "color", "$description": "Warm ivory — editorial/longform (NEW in v2)" },
      "paperDeep":  { "$value": "#F1EDE2", "$type": "color", "$description": "Recessed warm — cards on paper (NEW in v2)" }
    },

    "pastel": {
      "cyanLight":   { "$value": "#C8F9FE", "$type": "color" },
      "pinkLight":   { "$value": "#FCE3F1", "$type": "color" },
      "purpleLight": { "$value": "#F1E5FF", "$type": "color" }
    },

    "text": {
      "slateDark":   { "$value": "#334155", "$type": "color", "$description": "Subheadings, secondary text" },
      "slateMedium": { "$value": "#475569", "$type": "color", "$description": "Body text" },
      "slateLight":  { "$value": "#64748B", "$type": "color", "$description": "Captions" }
    },

    "line": {
      "border":       { "$value": "#E2E8F0", "$type": "color" },
      "borderStrong": { "$value": "#CBD5E1", "$type": "color" }
    },

    "state": {
      "success":  { "$value": "#22C55E", "$type": "color" },
      "error":    { "$value": "#EF4444", "$type": "color" },
      "warning":  { "$value": "#F59E0B", "$type": "color" },
      "star":     { "$value": "#F5C542", "$type": "color" },
      "deepBlue": { "$value": "#0C4A6E", "$type": "color" }
    },

    "semantic": {
      "fg": {
        "1":             { "$value": "{color.brand.navy}",        "$type": "color", "$description": "Primary text" },
        "2":             { "$value": "{color.text.slateDark}",    "$type": "color" },
        "3":             { "$value": "{color.text.slateMedium}",  "$type": "color", "$description": "Body" },
        "4":             { "$value": "{color.text.slateLight}",   "$type": "color", "$description": "Captions" },
        "onDark":        { "$value": "{color.surface.white}",     "$type": "color" },
        "mutedOnDark":   { "$value": "{color.line.borderStrong}", "$type": "color" },
        "onPaper":       { "$value": "{color.brand.navy}",        "$type": "color" },
        "bodyOnPaper":   { "$value": "{color.text.slateMedium}",  "$type": "color" }
      },
      "bg": {
        "1":          { "$value": "{color.surface.white}",     "$type": "color" },
        "2":          { "$value": "{color.surface.offWhite}",  "$type": "color" },
        "3":          { "$value": "{color.surface.surface2}",  "$type": "color" },
        "paper":      { "$value": "{color.surface.paper}",     "$type": "color" },
        "paperDeep":  { "$value": "{color.surface.paperDeep}", "$type": "color" },
        "dark":       { "$value": "{color.brand.navy}",        "$type": "color" },
        "darker":     { "$value": "{color.brand.navyDeep}",    "$type": "color" }
      },
      "action": {
        "primary":      { "$value": "{color.brand.cyan}",   "$type": "color" },
        "primaryHover": { "$value": "#06729F",              "$type": "color" },
        "accent":       { "$value": "{color.brand.pink}",   "$type": "color" },
        "accentHover":  { "$value": "#D6357F",              "$type": "color" }
      },
      "line": {
        "1":     { "$value": "{color.line.border}",        "$type": "color" },
        "2":     { "$value": "{color.line.borderStrong}",  "$type": "color" },
        "paper": { "$value": "rgba(27, 42, 74, 0.10)",     "$type": "color" }
      }
    }
  },

  "accessibility": {
    "$description": "Verified WCAG AA contrast pairings. Use these as ground truth; never sample by eye.",
    "navyOnWhite":         { "$value": "AAA", "ratio": 15.9 },
    "navyOnPaper":         { "$value": "AAA", "ratio": 14.8 },
    "slateMediumOnWhite":  { "$value": "AAA", "ratio": 7.5 },
    "slateMediumOnPaper":  { "$value": "AAA", "ratio": 7.0 },
    "slateLightOnWhite":   { "$value": "AA",  "ratio": 4.6 },
    "slateLightOnPaper":   { "$value": "AA-large-only", "ratio": 4.3, "note": "Use slateMedium for body on paper" },
    "pinkOnWhite":         { "$value": "AA-large-only", "ratio": 3.5, "note": "Headlines and CTAs only — never body" },
    "pinkOnNavy":          { "$value": "AA",  "ratio": 4.5 },
    "cyanOnWhite":         { "$value": "AA",  "ratio": 4.8 },
    "amberOnWhite":        { "$value": "FAIL","ratio": 2.1, "note": "Decorative only on light; for text use on navy" },
    "amberOnNavyDeep":     { "$value": "AA",  "ratio": 4.8 },
    "whiteOnNavy":         { "$value": "AAA", "ratio": 15.9 }
  },

  "font": {
    "system":  { "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif", "$type": "fontFamily" },
    "display": { "$value": "Figtree, {font.system}", "$type": "fontFamily", "$description": "Loaded from Google Fonts. Falls back to system stack." },
    "deck":    { "$value": "Arial, 'Helvetica Neue', sans-serif",                "$type": "fontFamily", "$description": "PowerPoint + Word — pre-installed everywhere" },
    "mono":    { "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily" }
  },

  "fontSize": {
    "xs":   { "$value": "0.75rem",  "$type": "dimension", "$description": "12px — caption" },
    "sm":   { "$value": "0.875rem", "$type": "dimension", "$description": "14px — supporting" },
    "base": { "$value": "1rem",     "$type": "dimension", "$description": "16px — body" },
    "lg":   { "$value": "1.125rem", "$type": "dimension", "$description": "18px — emphasis" },
    "xl":   { "$value": "1.25rem",  "$type": "dimension", "$description": "20px — H5" },
    "2xl":  { "$value": "1.5rem",   "$type": "dimension", "$description": "24px — H4" },
    "3xl":  { "$value": "1.875rem", "$type": "dimension", "$description": "30px — H3" },
    "4xl":  { "$value": "2.25rem",  "$type": "dimension", "$description": "36px — H2" },
    "5xl":  { "$value": "3rem",     "$type": "dimension", "$description": "48px — H1" },
    "6xl":  { "$value": "3.75rem",  "$type": "dimension", "$description": "60px — display" },
    "7xl":  { "$value": "4.5rem",   "$type": "dimension", "$description": "72px — display hero only" }
  },

  "fontWeight": {
    "regular":  { "$value": 400, "$type": "fontWeight" },
    "medium":   { "$value": 500, "$type": "fontWeight" },
    "semibold": { "$value": 600, "$type": "fontWeight" },
    "bold":     { "$value": 700, "$type": "fontWeight" },
    "black":    { "$value": 900, "$type": "fontWeight", "$description": "Figtree only — reserved for the boldest display moments" }
  },

  "lineHeight": {
    "tight":   { "$value": 1.0,  "$type": "number" },
    "snug":    { "$value": 1.2,  "$type": "number" },
    "normal":  { "$value": 1.5,  "$type": "number" },
    "relaxed": { "$value": 1.6,  "$type": "number" },
    "loose":   { "$value": 1.75, "$type": "number" }
  },

  "letterSpacing": {
    "tight":   { "$value": "-0.05em", "$type": "dimension" },
    "snug":    { "$value": "-0.01em", "$type": "dimension" },
    "normal":  { "$value": "0",       "$type": "dimension" },
    "wide":    { "$value": "0.08em",  "$type": "dimension" }
  },

  "space": {
    "0":  { "$value": "0",        "$type": "dimension" },
    "1":  { "$value": "0.25rem",  "$type": "dimension" },
    "2":  { "$value": "0.5rem",   "$type": "dimension" },
    "3":  { "$value": "0.75rem",  "$type": "dimension" },
    "4":  { "$value": "1rem",     "$type": "dimension" },
    "5":  { "$value": "1.25rem",  "$type": "dimension" },
    "6":  { "$value": "1.5rem",   "$type": "dimension" },
    "8":  { "$value": "2rem",     "$type": "dimension" },
    "10": { "$value": "2.5rem",   "$type": "dimension" },
    "12": { "$value": "3rem",     "$type": "dimension" },
    "16": { "$value": "4rem",     "$type": "dimension" },
    "20": { "$value": "5rem",     "$type": "dimension" },
    "24": { "$value": "6rem",     "$type": "dimension" },
    "32": { "$value": "8rem",     "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "0.375rem", "$type": "dimension" },
    "md":   { "$value": "0.5rem",   "$type": "dimension" },
    "lg":   { "$value": "0.75rem",  "$type": "dimension" },
    "xl":   { "$value": "1rem",     "$type": "dimension" },
    "2xl":  { "$value": "1.5rem",   "$type": "dimension" },
    "full": { "$value": "9999px",   "$type": "dimension" }
  },

  "container": {
    "tight":   { "$value": "720px",  "$type": "dimension", "$description": "Article body, longform reading" },
    "default": { "$value": "1200px", "$type": "dimension", "$description": "Standard marketing sections" },
    "wide":    { "$value": "1440px", "$type": "dimension", "$description": "Full-feel sections" }
  },

  "shadow": {
    "sm":          { "$value": "0 1px 2px 0 rgba(0,0,0,0.05)", "$type": "shadow" },
    "md":          { "$value": "0 4px 6px -1px rgba(0,0,0,0.10), 0 2px 4px -1px rgba(0,0,0,0.06)", "$type": "shadow" },
    "lg":          { "$value": "0 10px 15px -3px rgba(0,0,0,0.10), 0 4px 6px -2px rgba(0,0,0,0.05)", "$type": "shadow" },
    "xl":          { "$value": "0 20px 25px -5px rgba(0,0,0,0.10), 0 10px 10px -5px rgba(0,0,0,0.04)", "$type": "shadow" },
    "cardHover":   { "$value": "0 4px 8px rgba(0,0,0,0.04), 0 12px 24px rgba(0,0,0,0.08)", "$type": "shadow" },
    "buttonHover": { "$value": "0 4px 12px rgba(0,0,0,0.15)", "$type": "shadow" },
    "onNavy":      { "$value": "0 12px 30px rgba(13,27,63,0.18)", "$type": "shadow" }
  },

  "motion": {
    "ease": {
      "out":    { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)", "$type": "cubicBezier" },
      "inOut":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",     "$type": "cubicBezier" },
      "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)","$type": "cubicBezier" }
    },
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration", "$description": "Hover/focus state changes" },
      "base":   { "$value": "200ms", "$type": "duration", "$description": "Button press, small state change" },
      "slow":   { "$value": "300ms", "$type": "duration", "$description": "Modal entry, page-level state" },
      "page":   { "$value": "600ms", "$type": "duration", "$description": "Scroll reveal, large block entry" },
      "reveal": { "$value": "800ms", "$type": "duration", "$description": "Generous reveal — for hero moments" }
    }
  },

  "component": {
    "$description": "State-specific tokens for component primitives — buttons, inputs, etc. Implementations live with the components themselves; these are the canonical sizes.",
    "button": {
      "sm": { "height": "2rem",   "padding": "0 0.75rem", "fontSize": "{fontSize.xs}" },
      "md": { "height": "2.5rem", "padding": "0 1rem",    "fontSize": "{fontSize.sm}" },
      "lg": { "height": "3rem",   "padding": "0 1.5rem",  "fontSize": "{fontSize.base}" }
    },
    "input": {
      "height":  "2.75rem",
      "padding": "0 0.875rem",
      "border":  "1px",
      "radius":  "{radius.md}"
    },
    "disabled": {
      "opacity": 0.5
    },
    "focusRing": {
      "default": "0 0 0 3px rgba(8, 138, 191, 0.4)",
      "onDark":  "0 0 0 3px rgba(233, 63, 142, 0.5)"
    }
  },

  "meta": {
    "version":    "2.0",
    "date":       "2026-05-16",
    "supersedes": "colors_and_type.css v1.x + wireframe direction B --c-* tokens",
    "docs":       "design-system/DESIGN.md",
    "css":        "design-system/tokens.css",
    "license":    "Proprietary — Accelerator X Ltd"
  }
}
